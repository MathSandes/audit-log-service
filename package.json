{
  "name": "audit-log-service",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/http/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http/server.js",
    "migrate:generate": "ts-node ./node_modules/typeorm/cli.js migration:generate -n",
    "migrate:run": "ts-node ./node_modules/typeorm/cli.js migration:run",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "fastify": "^4.25.0",
    "zod": "^3.23.0",
    "reflect-metadata": "^0.1.13",
    "pg": "^8.10.0",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.4.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "vitest": "^1.4.4",
    "@types/uuid": "^9.0.2",
    "eslint": "^8.49.0",
    "@typescript-eslint/parser": "^6.8.0",
    "@typescript-eslint/eslint-plugin": "^6.8.0"
  }
}
